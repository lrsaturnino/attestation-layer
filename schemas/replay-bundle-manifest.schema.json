      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_store_id": {
      "title": "Source Store Id",
      "type": "string"
    }
  },
  "required": [
