          "type": "string"
        },
        "logical_name": {
          "title": "Logical Name",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metadata",
          "type": "object"
        },
        "normalized": {
          "default": false,
          "title": "Normalized",
          "type": "boolean"
        },
        "raw": {
          "default": false,
          "title": "Raw",
          "type": "boolean"
        },
        "retained": {
          "default": true,
          "title": "Retained",
          "type": "boolean"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "store_path": {
          "title": "Store Path",
          "type": "string"
        }
      },
      "required": [
