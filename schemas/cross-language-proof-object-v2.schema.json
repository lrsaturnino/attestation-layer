{
  "$defs": {
    "AdapterEvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "artifact_hash": {
          "title": "Artifact Hash",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Level"
        },
        "producer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Id"
        },
        "replay_bundle_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replay Bundle Hash"
        }
      },
      "required": [
        "evidence_id",
        "adapter_id",
        "artifact_hash"
      ],
      "title": "AdapterEvidenceReference",
      "type": "object"
    },
    "CausalTraceLinkV2": {
      "additionalProperties": false,
      "properties": {
        "evidence_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Hash"
        },
        "from_adapter_id": {
          "title": "From Adapter Id",
          "type": "string"
        },
        "from_event_id": {
          "title": "From Event Id",
          "type": "string"
        },
        "from_trace_id": {
          "title": "From Trace Id",
          "type": "string"
        },
        "link_id": {
          "title": "Link Id",
          "type": "string"
        },
        "relation": {
          "enum": [
            "causes",
            "follows",
            "correlates"
          ],
          "title": "Relation",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "default": "unverified",
          "enum": [
            "satisfied",
            "missing_source",
            "missing_target",
            "unverified"
          ],
          "title": "Status",
          "type": "string"
        },
        "to_adapter_id": {
          "title": "To Adapter Id",
          "type": "string"
        },
        "to_event_id": {
          "title": "To Event Id",
          "type": "string"
        },
        "to_trace_id": {
          "title": "To Trace Id",
          "type": "string"
        }
      },
      "required": [
        "link_id",
        "from_adapter_id",
        "from_trace_id",
        "from_event_id",
        "to_adapter_id",
        "to_trace_id",
        "to_event_id",
        "relation"
      ],
      "title": "CausalTraceLinkV2",
      "type": "object"
    },
    "CrossLanguageEvidenceSliceV2": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/CrossLanguageProofBlocker"
          },
          "title": "Blockers",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/AdapterEvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "module_ids": {
          "items": {
            "type": "string"
          },
          "title": "Module Ids",
          "type": "array"
        },
        "runtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "trace_ids": {
          "items": {
            "type": "string"
          },
          "title": "Trace Ids",
          "type": "array"
        }
      },
      "required": [
        "adapter_id",
        "language"
      ],
      "title": "CrossLanguageEvidenceSliceV2",
      "type": "object"
    },
    "CrossLanguageProofBlocker": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "proof",
            "language_diversity",
            "trace_link",
            "adapter_evidence",
            "replay_bundle"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "CrossLanguageProofBlocker",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_count": {
      "default": 0,
      "title": "Adapter Count",
      "type": "integer"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/CrossLanguageProofBlocker"
      },
      "title": "Blockers",
      "type": "array"
    },
    "causal_links": {
      "items": {
        "$ref": "#/$defs/CausalTraceLinkV2"
      },
      "title": "Causal Links",
      "type": "array"
    },
    "closure_status": {
      "enum": [
        "closed",
        "blocked"
      ],
      "title": "Closure Status",
      "type": "string"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "language_count": {
      "default": 0,
      "title": "Language Count",
      "type": "integer"
    },
    "proof_id": {
      "title": "Proof Id",
      "type": "string"
    },
    "proof_status": {
      "enum": [
        "closed",
        "open",
        "blocked"
      ],
      "title": "Proof Status",
      "type": "string"
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "result": {
      "enum": [
        "accepted",
        "refused",
        "unknown"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "slices": {
      "items": {
        "$ref": "#/$defs/CrossLanguageEvidenceSliceV2"
      },
      "title": "Slices",
      "type": "array"
    },
    "tool": {
      "default": "nlreq.cross_language",
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "default": "0.1",
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "proof_id",
    "requirement_id",
    "result",
    "closure_status",
    "proof_status"
  ],
  "title": "CrossLanguageProofObjectV2",
  "type": "object"
}
