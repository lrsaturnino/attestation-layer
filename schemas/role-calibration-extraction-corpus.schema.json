{
  "$defs": {
    "ExtractionCalibrationCase": {
      "additionalProperties": false,
      "description": "An extraction-calibration case.\n\n``module_id`` / ``code_presentation`` / ``language`` are the extractor's inputs.\n``gold_invariants`` is the correct invariant set (``{name, tla}``). ``recorded_estimate`` is\nthe planted raw JSON extraction replayed in the recorded discriminator.",
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "code_presentation": {
          "title": "Code Presentation",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "fault_kind": {
          "enum": [
            "faithful",
            "false_acceptance",
            "false_refusal"
          ],
          "title": "Fault Kind",
          "type": "string"
        },
        "gold_invariants": {
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Gold Invariants",
          "type": "array"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "module_id": {
          "title": "Module Id",
          "type": "string"
        },
        "recorded_estimate": {
          "title": "Recorded Estimate",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "title",
        "domain",
        "fault_kind",
        "module_id",
        "code_presentation",
        "recorded_estimate"
      ],
      "title": "ExtractionCalibrationCase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/ExtractionCalibrationCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "corpus_id": {
      "title": "Corpus Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "version",
    "cases"
  ],
  "title": "ExtractionCalibrationCorpus",
  "type": "object"
}
