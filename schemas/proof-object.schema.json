              "$ref": "#/$defs/EvidenceLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "backend_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backend Status"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "node_kind": {
          "title": "Node Kind",
          "type": "string"
        },
        "premise_id": {
          "title": "Premise Id",
          "type": "string"
        },
        "producer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Producer Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
