        "message": {
          "title": "Message",
          "type": "string"
        },
        "premise_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Premise Id"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "ProofClosureBlocker",
      "type": "object"
    },
    "ProofDispatchPlan": {
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "title": "Policy Id",
          "type": "string"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/ProofPremiseRoute"
          },
          "title": "Routes",
          "type": "array"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id"
      ],
      "title": "ProofDispatchPlan",
      "type": "object"
    },
    "ProofPremise": {
      "additionalProperties": false,
      "properties": {
        "achieved_evidence": {
          "anyOf": [
