  "additionalProperties": false,
  "properties": {
    "backend_agreement": {
      "anyOf": [
        {
          "$ref": "#/$defs/BackendAgreementReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "backend_results": {
      "items": {
        "$ref": "#/$defs/BackendResult"
      },
      "title": "Backend Results",
      "type": "array"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/ProofClosureBlocker"
      },
      "title": "Blockers",
      "type": "array"
    },
    "coverage_result": {
      "enum": [
        "passed",
        "blocked",
        "missing"
      ],
      "title": "Coverage Result",
      "type": "string"
    },
    "dispatch": {
      "$ref": "#/$defs/ProofDispatchPlan"
    },
    "premises": {
      "items": {
        "$ref": "#/$defs/ProofPremise"
      },
      "title": "Premises",
      "type": "array"
    },
    "producer_mapping": {
      "$ref": "#/$defs/EvidenceProducerMapping"
    },
    "proof_id": {
      "title": "Proof Id",
      "type": "string"
    },
    "reproducibility": {
      "$ref": "#/$defs/ProofReproducibility"
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "requirement_ir_hash": {
      "title": "Requirement Ir Hash",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "closed",
        "open",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "trace_alignment_result": {
      "enum": [
        "passed",
        "blocked",
        "missing"
      ],
      "title": "Trace Alignment Result",
      "type": "string"
    }
  },
  "required": [
    "proof_id",
    "requirement_id",
    "requirement_ir_hash",
    "status",
    "dispatch",
    "producer_mapping",
    "coverage_result",
    "trace_alignment_result",
    "reproducibility"
  ],
  "title": "ProofObject",
  "type": "object"
}
