    "ProofPremiseRoute": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "title": "Backend Id",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "node_kind": {
          "title": "Node Kind",
          "type": "string"
        },
        "premise_id": {
          "title": "Premise Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "required_evidence": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "role": {
          "enum": [
            "premise",
            "obligation"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "premise_id",
        "node_id",
        "node_kind",
        "role",
        "backend_id",
        "required_evidence",
        "reason"
      ],
      "title": "ProofPremiseRoute",
      "type": "object"
    },
    "ProofReproducibility": {
      "additionalProperties": false,
      "properties": {
        "input_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input Hashes",
          "type": "object"
        },
        "tool": {
          "default": "nlreq.proof_closure",
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "default": "0.1",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "title": "ProofReproducibility",
      "type": "object"
    }
