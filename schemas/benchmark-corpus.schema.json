{
  "$defs": {
    "BenchmarkCase": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Artifacts",
          "type": "object"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/BenchmarkExpectedOutcome"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "title",
        "description",
        "expected"
      ],
      "title": "BenchmarkCase",
      "type": "object"
    },
    "BenchmarkExpectedOutcome": {
      "additionalProperties": false,
      "properties": {
        "counterexample_expected": {
          "default": false,
          "title": "Counterexample Expected",
          "type": "boolean"
        },
        "decision": {
          "enum": [
            "accepted",
            "refused",
            "unknown"
          ],
          "title": "Decision",
          "type": "string"
        },
        "failure_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Mode"
        }
      },
      "required": [
        "decision"
      ],
      "title": "BenchmarkExpectedOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/BenchmarkCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "corpus_id": {
      "title": "Corpus Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "version"
  ],
  "title": "BenchmarkCorpus",
  "type": "object"
