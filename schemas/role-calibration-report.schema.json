{
  "$defs": {
    "CalibrationProvenance": {
      "additionalProperties": false,
      "description": "Self-describing per-role / per-model calibration provenance (scope \u00a75, ADR 0204 \u00a74).\n\nStamped onto a ``RequirementTranslationBenchmarkReport`` when ``--llm-client`` calibrates a\nrole, so the false-acceptance / false-refusal tables are self-describing by role / client\nkind / provider / resolved model / wrapper identity / prompt version \u2014 no reliance on\nexternal filenames or prose (recommended action #2). All transport-specific fields are\noptional so a partial provenance (e.g. anthropic with no wrapper) is honest rather than\nfabricated; ``jsonutil.to_jsonable`` serializes with ``exclude_none=True``, so absent fields\nare omitted and a non-calibration report (``calibration=None``) is byte-identical to before.",
      "properties": {
        "cli_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cli Version"
        },
        "client_kind": {
          "title": "Client Kind",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "resolved_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Model"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "transport_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport Source"
        },
        "wrapper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wrapper"
        },
        "wrapper_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wrapper Hash"
        }
      },
      "required": [
        "role",
        "client_kind"
      ],
      "title": "CalibrationProvenance",
      "type": "object"
    },
    "RoleCalibrationCaseResult": {
      "additionalProperties": false,
      "description": "One case's scored outcome under a role-calibration run.\n\n``matched`` / ``false_acceptance`` / ``false_refusal`` are not mutually exclusive for the\nset-valued roles (impact / extraction): a partial-overlap estimate is both an over-claim (FA)\nand an under-claim (FR). For the verdict/signature roles (decomposition / audit) they are\nmutually exclusive. ``matched`` is True only when neither FA nor FR fired.",
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "false_acceptance": {
          "default": false,
          "title": "False Acceptance",
          "type": "boolean"
        },
        "false_refusal": {
          "default": false,
          "title": "False Refusal",
          "type": "boolean"
        },
        "fault_kind": {
          "enum": [
            "faithful",
            "false_acceptance",
            "false_refusal"
          ],
          "title": "Fault Kind",
          "type": "string"
        },
        "matched": {
          "default": false,
          "title": "Matched",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "fault_kind"
      ],
      "title": "RoleCalibrationCaseResult",
      "type": "object"
    },
    "RoleCalibrationSubgroupMetrics": {
      "additionalProperties": false,
      "description": "Per-subgroup (domain or language) FA/FR breakdown.\n\nBoth rates are reported separately and never collapsed into one \"accuracy\" \u2014 false-acceptance\nand false-refusal trade off against each other and must be read independently, exactly as in\nthe drafting report.",
      "properties": {
        "false_acceptance_count": {
          "title": "False Acceptance Count",
          "type": "integer"
        },
        "false_acceptance_rate": {
          "title": "False Acceptance Rate",
          "type": "number"
        },
        "false_refusal_count": {
          "title": "False Refusal Count",
          "type": "integer"
        },
        "false_refusal_rate": {
          "title": "False Refusal Rate",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "matched_count": {
          "title": "Matched Count",
          "type": "integer"
        },
        "total_cases": {
          "title": "Total Cases",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "total_cases",
        "matched_count",
        "false_acceptance_count",
        "false_acceptance_rate",
        "false_refusal_count",
        "false_refusal_rate"
      ],
      "title": "RoleCalibrationSubgroupMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Self-describing per-role FA/FR calibration report.\n\n``result`` is ``\"passed\"`` only when every case matched (FA=0 AND FR=0). A discriminator run\nover a planted-error corpus is EXPECTED to be ``\"failed\"`` \u2014 that non-zero FA/FR is the\nnon-vacuity proof that the harness discriminates (a constant-zero instrument would pass\nvacuously). The committed discriminator reports therefore read as ``\"failed\"`` by design.\n``calibration`` is None for a plain recorded ``--run`` (byte-stable, like the drafting release\ncorpus) and populated only for a ``--llm-client`` calibration run.",
  "properties": {
    "calibration": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalibrationProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "corpus_id": {
      "title": "Corpus Id",
      "type": "string"
    },
    "domains": {
      "items": {
        "$ref": "#/$defs/RoleCalibrationSubgroupMetrics"
      },
      "title": "Domains",
      "type": "array"
    },
    "false_acceptance_count": {
      "default": 0,
      "title": "False Acceptance Count",
      "type": "integer"
    },
    "false_acceptance_rate": {
      "title": "False Acceptance Rate",
      "type": "number"
    },
    "false_refusal_count": {
      "default": 0,
      "title": "False Refusal Count",
      "type": "integer"
    },
    "false_refusal_rate": {
      "default": 0.0,
      "title": "False Refusal Rate",
      "type": "number"
    },
    "languages": {
      "items": {
        "$ref": "#/$defs/RoleCalibrationSubgroupMetrics"
      },
      "title": "Languages",
      "type": "array"
    },
    "matched_cases": {
      "title": "Matched Cases",
      "type": "integer"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/RoleCalibrationCaseResult"
      },
      "title": "Observations",
      "type": "array"
    },
    "result": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Result",
      "type": "string"
    },
    "role": {
      "enum": [
        "decomposition",
        "impact",
        "extraction",
        "audit"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "total_cases": {
      "title": "Total Cases",
      "type": "integer"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "role",
    "corpus_id",
    "version",
    "result",
    "total_cases",
    "matched_cases",
    "false_acceptance_rate"
  ],
  "title": "RoleCalibrationReport",
  "type": "object"
}
