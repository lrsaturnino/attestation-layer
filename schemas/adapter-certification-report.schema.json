{
  "$defs": {
    "AdapterCapabilityClaim": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "enum": [
            "manifest",
            "binding_validation",
            "static_symbol_resolution",
            "call_graph",
            "code_presentation",
            "source_impact",
            "coverage_mapping",
            "normalized_trace",
            "runtime_trace_extraction",
            "specula_candidate_extraction"
          ],
          "title": "Capability Id",
          "type": "string"
        },
        "evidence_labels": {
          "items": {
            "$ref": "#/$defs/EvidenceLevel"
          },
          "title": "Evidence Labels",
          "type": "array"
        },
        "level": {
          "enum": [
            "manifest_only",
            "static_resolution",
            "trace_capable",
            "production_candidate"
          ],
          "title": "Level",
          "type": "string"
        },
        "limitation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Limitation Ids",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "requires_external_tool": {
          "default": false,
          "title": "Requires External Tool",
          "type": "boolean"
        }
      },
      "required": [
        "capability_id",
        "level"
      ],
      "title": "AdapterCapabilityClaim",
      "type": "object"
    },
    "AdapterCapabilityContract": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/AdapterCapabilityClaim"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "capability_level": {
          "default": "manifest_only",
          "enum": [
            "manifest_only",
            "static_resolution",
            "trace_capable",
            "production_candidate"
          ],
          "title": "Capability Level",
          "type": "string"
        },
        "ecosystem": {
          "default": "generic",
          "enum": [
            "generic",
            "transaction_event",
            "compiled_service",
            "frontend_service",
            "compiled_system",
            "dynamic_scripting"
          ],
          "title": "Ecosystem",
          "type": "string"
        },
        "failure_taxonomy": {
          "items": {
            "type": "string"
          },
          "title": "Failure Taxonomy",
          "type": "array"
        },
        "interface_version": {
          "const": "2.0",
          "default": "2.0",
          "title": "Interface Version",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/AdapterLimitation"
          },
          "title": "Limitations",
          "type": "array"
        },
        "optional_methods": {
          "items": {
            "type": "string"
          },
          "title": "Optional Methods",
          "type": "array"
        },
        "required_methods": {
          "items": {
            "type": "string"
          },
          "title": "Required Methods",
          "type": "array"
        },
        "runtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "schema_version": {
          "const": "0.2",
          "default": "0.2",
          "title": "Schema Version",
          "type": "string"
        },
        "supported_evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceLevel"
          },
          "title": "Supported Evidence",
          "type": "array"
        },
        "supported_symbol_types": {
          "items": {
            "type": "string"
          },
          "title": "Supported Symbol Types",
          "type": "array"
        },
        "supported_trace_runtimes": {
          "items": {
            "type": "string"
          },
          "title": "Supported Trace Runtimes",
          "type": "array"
        }
      },
      "required": [
        "adapter_id",
        "language"
      ],
      "title": "AdapterCapabilityContract",
      "type": "object"
    },
    "AdapterCertificationFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "manifest",
            "capability_contract",
            "symbol_resolution",
            "binding_validation",
            "call_graph",
            "code_presentation",
            "trace_extraction",
            "plugin_sdk"
          ],
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        }
      },
      "required": [
        "category",
        "severity",
        "message"
      ],
      "title": "AdapterCertificationFinding",
      "type": "object"
    },
    "AdapterLimitation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "analysis_depth",
            "language_feature",
            "runtime_trace",
            "tooling",
            "dynamic_behavior",
            "coverage_mapping",
            "specula_integration"
          ],
          "title": "Category",
          "type": "string"
        },
        "closure_effect": {
          "default": "review",
          "enum": [
            "unsupported",
            "review",
            "block"
          ],
          "title": "Closure Effect",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "limitation_id": {
          "title": "Limitation Id",
          "type": "string"
        }
      },
      "required": [
        "limitation_id",
        "category",
        "description"
      ],
      "title": "AdapterLimitation",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "TYPE_CHECKED",
        "CONSISTENCY_CHECKED",
        "STATICALLY_RESOLVED",
        "SMT_CHECKED",
        "TEST_VALIDATED",
        "TRACE_VALIDATED",
        "BOUNDED_CHECKED",
        "PROVEN_INDUCTIVE",
        "REVIEWED"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "title": "Adapter Id",
      "type": "string"
    },
    "call_graph_edges": {
      "default": 0,
      "title": "Call Graph Edges",
      "type": "integer"
    },
    "call_graph_tool_backed": {
      "default": false,
      "title": "Call Graph Tool Backed",
      "type": "boolean"
    },
    "capability_contract": {
      "$ref": "#/$defs/AdapterCapabilityContract"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/AdapterCertificationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "interface_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Interface Version",
      "type": "string"
    },
    "language": {
      "title": "Language",
      "type": "string"
    },
    "level": {
      "enum": [
        "manifest_only",
        "static_resolution",
        "trace_capable",
        "production_candidate"
      ],
      "title": "Level",
      "type": "string"
    },
    "limitation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Limitation Ids",
      "type": "array"
    },
    "missing_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Missing Capabilities",
      "type": "array"
    },
    "plugin_sdk_compatible": {
      "default": false,
      "title": "Plugin Sdk Compatible",
      "type": "boolean"
    },
    "required_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array"
    },
    "resolved_symbols": {
      "default": 0,
      "title": "Resolved Symbols",
      "type": "integer"
    },
    "result": {
      "enum": [
        "certified",
        "blocked"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "source_presentation_snippets": {
      "default": 0,
      "title": "Source Presentation Snippets",
      "type": "integer"
    },
    "supported_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceLevel"
      },
      "title": "Supported Evidence",
      "type": "array"
    },
    "tool": {
      "default": "nlreq.adapter_certification",
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "default": "0.2",
      "title": "Tool Version",
      "type": "string"
    },
    "trace_count": {
      "default": 0,
      "title": "Trace Count",
      "type": "integer"
    },
    "unresolved_symbols": {
      "default": 0,
      "title": "Unresolved Symbols",
      "type": "integer"
    }
  },
  "required": [
    "adapter_id",
    "language",
    "result",
    "level",
    "capability_contract"
  ],
  "title": "AdapterCertificationReport",
  "type": "object"
}
