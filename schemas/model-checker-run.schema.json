{
  "$defs": {
    "ModelCheckerBudget": {
      "additionalProperties": false,
      "properties": {
        "max_depth": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth"
        },
        "max_states": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max States"
        },
        "memory_budget_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Budget Mb"
        },
        "solver_options": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Solver Options",
          "type": "object"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        }
      },
      "title": "ModelCheckerBudget",
      "type": "object"
    },
    "ModelCheckerCounterexample": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "marker": {
          "title": "Marker",
          "type": "string"
        },
        "source": {
          "enum": [
            "stdout",
            "stderr",
            "combined"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "marker",
        "excerpt"
      ],
      "title": "ModelCheckerCounterexample",
      "type": "object"
    },
    "ModelCheckerOutput": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "tail": {
          "title": "Tail",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "sha256",
        "tail",
        "truncated"
      ],
      "title": "ModelCheckerOutput",
      "type": "object"
    },
    "ModelCheckerReproducibility": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "$ref": "#/$defs/ModelCheckerBudget"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "command_line": {
          "title": "Command Line",
          "type": "string"
        },
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "executable": {
          "title": "Executable",
          "type": "string"
        },
        "executable_resolved": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable Resolved"
        },
        "tool_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "tool_version_command": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version Command"
        }
      },
      "required": [
        "cwd",
        "command",
        "command_line",
        "executable",
        "budget"
      ],
      "title": "ModelCheckerReproducibility",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checker_id": {
      "title": "Checker Id",
      "type": "string"
    },
    "counterexamples": {
      "items": {
        "$ref": "#/$defs/ModelCheckerCounterexample"
      },
      "title": "Counterexamples",
      "type": "array"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exit Code"
    },
    "expected_exit_code": {
      "title": "Expected Exit Code",
      "type": "integer"
    },
    "outcome": {
      "enum": [
        "valid",
        "counterexample",
        "timeout",
        "unsupported",
        "tool_error"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "reproducibility": {
      "$ref": "#/$defs/ModelCheckerReproducibility"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "stderr": {
      "$ref": "#/$defs/ModelCheckerOutput"
    },
    "stdout": {
      "$ref": "#/$defs/ModelCheckerOutput"
    },
    "timed_out": {
      "default": false,
      "title": "Timed Out",
      "type": "boolean"
    },
    "tool_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Error"
    },
    "unsupported_markers": {
      "items": {
        "type": "string"
      },
      "title": "Unsupported Markers",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "checker_id",
    "outcome",
    "exit_code",
    "expected_exit_code",
    "stdout",
    "stderr",
    "reproducibility"
  ],
  "title": "ModelCheckerRunResult",
  "type": "object"
}
