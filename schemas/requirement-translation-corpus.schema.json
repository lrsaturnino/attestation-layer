{
  "$defs": {
    "RequirementTranslationCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/RequirementTranslationExpected"
        },
        "input_kind": {
          "enum": [
            "controlled",
            "messy_prose",
            "ambiguous_prose",
            "incomplete_prose",
            "multilingual",
            "adversarial"
          ],
          "title": "Input Kind",
          "type": "string"
        },
        "input_text": {
          "title": "Input Text",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "title",
        "input_text",
        "input_kind",
        "expected"
      ],
      "title": "RequirementTranslationCase",
      "type": "object"
    },
    "RequirementTranslationExpected": {
      "additionalProperties": false,
      "properties": {
        "expected_clarification_questions": {
          "items": {
            "type": "string"
          },
          "title": "Expected Clarification Questions",
          "type": "array"
        },
        "expected_ir_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Ir Path"
        },
        "expected_refusal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Refusal Code"
        },
        "outcome": {
          "enum": [
            "accepted",
            "clarification",
            "refused"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "outcome"
      ],
      "title": "RequirementTranslationExpected",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/RequirementTranslationCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "corpus_id": {
      "title": "Corpus Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "version",
    "cases"
  ],
  "title": "RequirementTranslationCorpus",
  "type": "object"
}
