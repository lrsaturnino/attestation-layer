{
  "$defs": {
    "RequirementContradiction": {
      "additionalProperties": false,
      "properties": {
        "contradiction_type": {
          "enum": [
            "numeric_range_disjointness",
            "mutual_exclusion",
            "action_order_conflict"
          ],
          "title": "Contradiction Type",
          "type": "string"
        },
        "fragments": {
          "items": {
            "type": "string"
          },
          "title": "Fragments",
          "type": "array"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "minItems": 1,
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "contradiction_type",
        "requirement_ids",
        "fragments",
        "source_spans"
      ],
      "title": "RequirementContradiction",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "title": "Document",
          "type": "string"
        },
        "end_char": {
          "minimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document",
        "start_char",
        "end_char",
        "text"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "UncheckedRequirement": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "reason": {
          "enum": [
            "lowering_refused",
            "lowering_needs_review",
            "contradiction_without_source_span"
          ],
          "title": "Reason",
          "type": "string"
        },
        "refusal_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refusal Code"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Ids",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "requirement_ids",
        "reason",
        "detail"
      ],
      "title": "UncheckedRequirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contradictions": {
      "items": {
        "$ref": "#/$defs/RequirementContradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "result": {
      "enum": [
        "valid",
        "contradiction",
        "unsupported"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "unchecked": {
      "items": {
        "$ref": "#/$defs/UncheckedRequirement"
      },
      "title": "Unchecked",
      "type": "array"
    }
  },
  "required": [
    "result"
  ],
  "title": "RequirementSetConsistencyReport",
  "type": "object"
}
