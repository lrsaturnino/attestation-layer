{
  "$defs": {
    "NormalizedTrace": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/TraceEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "producer": {
          "anyOf": [
            {
              "$ref": "#/$defs/NormalizedTraceProducer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "adapter_id",
        "source_hash",
        "events"
      ],
      "title": "NormalizedTrace",
      "type": "object"
    },
    "NormalizedTraceArtifact": {
      "items": {
        "$ref": "#/$defs/NormalizedTrace"
      },
      "title": "NormalizedTraceArtifact",
      "type": "array"
    },
    "NormalizedTraceProducer": {
      "additionalProperties": false,
      "description": "Recorded real-tool provenance for a trace the adapter *produced* (not ingested).\n\nA trace carries a producer iff a real external tool ran to extract it \u2014 Foundry for the\nSolidity vertical (PC-4), a real OpenTelemetry/runtime producer for others. ``tool`` is the\nbinary that ran and ``tool_version`` is its captured version string; together with the\nenclosing trace's ``source_hash`` (the hash of the real tool artifact the trace was projected\nfrom) they are the \"captured tool version + real artifact hash\" the capability gate requires\nbefore an adapter may certify a ``trace_capable``/``production_candidate`` capability. A trace\ningested from manifest-declared JSON has ``producer == None`` on its enclosing trace and so can\nnever lift a regex/static adapter above ``static_resolution``.",
      "properties": {
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "tool_version"
      ],
      "title": "NormalizedTraceProducer",
      "type": "object"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "title": "Action",
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actor"
        },
        "causal_predecessor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Causal Predecessor"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "post_state": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post State"
        },
        "pre_state": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre State"
        },
        "runtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Timestamp"
        }
      },
      "required": [
        "event_id",
        "timestamp",
        "action"
      ],
      "title": "TraceEvent",
      "type": "object"
    },
    "TraceLossRecord": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "default": "blocking",
          "enum": [
            "info",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "field",
        "reason"
      ],
      "title": "TraceLossRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "loss_records": {
      "items": {
