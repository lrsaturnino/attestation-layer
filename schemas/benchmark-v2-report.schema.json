{
  "$defs": {
    "BenchmarkV2Metric": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "default": true,
          "title": "Passed",
          "type": "boolean"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "BenchmarkV2Metric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_report_hash": {
      "title": "Base Report Hash",
      "type": "string"
    },
    "category_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Category Counts",
      "type": "object"
    },
    "corpus_id": {
      "title": "Corpus Id",
      "type": "string"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/BenchmarkV2Metric"
      },
      "title": "Metrics",
      "type": "array"
    },
    "result": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool": {
      "default": "nlreq.benchmark_v2",
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "default": "0.1",
      "title": "Tool Version",
      "type": "string"
    },
    "total_cases": {
      "title": "Total Cases",
      "type": "integer"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "version",
    "result",
    "total_cases",
    "base_report_hash"
  ],
  "title": "BenchmarkV2Report",
  "type": "object"
}
