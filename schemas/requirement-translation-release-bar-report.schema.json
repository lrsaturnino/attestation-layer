      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "thresholds": {
      "$ref": "#/$defs/RequirementTranslationReleaseThresholds"
    }
  },
  "required": [
    "result",
    "benchmark_report_hash",
    "thresholds"
