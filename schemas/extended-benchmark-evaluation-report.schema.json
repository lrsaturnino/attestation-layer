        "$ref": "#/$defs/ExtendedBenchmarkDimensionResult"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "failed_dimensions": {
      "items": {
        "type": "string"
      },
      "title": "Failed Dimensions",
      "type": "array"
    },
    "input_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Input Hashes",
      "type": "object"
    },
    "missing_dimensions": {
