          "title": "Passed",
          "type": "boolean"
        },
        "passed_cases": {
          "default": 0,
          "title": "Passed Cases",
          "type": "integer"
        },
        "score": {
          "default": 0.0,
          "title": "Score",
          "type": "number"
        },
        "threshold": {
          "default": 1.0,
          "title": "Threshold",
          "type": "number"
        },
        "total_cases": {
          "default": 0,
          "title": "Total Cases",
          "type": "integer"
        }
