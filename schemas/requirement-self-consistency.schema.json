{
  "$defs": {
    "BackendResult": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "evidence_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "valid",
            "invalid",
            "counterexample",
            "timeout",
            "unsupported",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "status"
      ],
      "title": "BackendResult",
      "type": "object"
    },
    "ConsumedAnnotation": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "items": {
            "type": "string"
          },
          "title": "Keys",
          "type": "array"
        },
        "namespace": {
          "title": "Namespace",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "namespace",
        "schema_version"
      ],
      "title": "ConsumedAnnotation",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "TYPE_CHECKED",
        "CONSISTENCY_CHECKED",
        "STATICALLY_RESOLVED",
        "SMT_CHECKED",
        "TEST_VALIDATED",
        "TRACE_VALIDATED",
        "BOUNDED_CHECKED",
        "PROVEN_INDUCTIVE",
        "REVIEWED"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "FormalBackendResponse": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "title": "Backend Id",
          "type": "string"
        },
        "consumed_annotations": {
          "items": {
            "$ref": "#/$defs/ConsumedAnnotation"
          },
          "title": "Consumed Annotations",
          "type": "array"
        },
        "lowered_artifact_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lowered Artifact Hash"
        },
        "result": {
          "$ref": "#/$defs/BackendResult"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "enum": [
            "tla",
            "smt",
            "ltl",
            "alloy",
            "lean"
          ],
          "title": "Target",
          "type": "string"
        },
        "unsupported_constructs": {
          "items": {
            "$ref": "#/$defs/UnsupportedConstruct"
          },
          "title": "Unsupported Constructs",
          "type": "array"
        }
      },
      "required": [
        "backend_id",
        "target",
        "result"
      ],
      "title": "FormalBackendResponse",
      "type": "object"
    },
    "RequirementSelfContradiction": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "contradiction_type": {
          "enum": [
            "opposite_fragment",
            "direct_opposite_predicates",
            "impossible_comparison",
            "mutually_exclusive_states",
            "overlapping_opposite_obligations",
            "temporal_impossibility",
            "numeric_bound_conflict",
            "duplicate_obligation_conflict",
            "backend_counterexample"
          ],
          "title": "Contradiction Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "contradiction_type",
        "message"
      ],
      "title": "RequirementSelfContradiction",
      "type": "object"
    },
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "title": "Document",
          "type": "string"
        },
        "end_char": {
          "minimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document",
        "start_char",
        "end_char",
        "text"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "UnsupportedConstruct": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "kind",
        "reason"
      ],
      "title": "UnsupportedConstruct",
      "type": "object"
    },
    "UntrustedContradictionSuggestion": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "producer": {
          "default": "untrusted",
          "title": "Producer",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/SourceSpan"
          },
          "title": "Source Spans",
          "type": "array"
        },
        "suggested_type": {
          "title": "Suggested Type",
          "type": "string"
        },
        "suggestion_id": {
          "title": "Suggestion Id",
          "type": "string"
        }
      },
      "required": [
        "suggestion_id",
        "suggested_type",
        "message"
      ],
      "title": "UntrustedContradictionSuggestion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checked_taxonomy_codes": {
      "items": {
        "type": "string"
      },
      "title": "Checked Taxonomy Codes",
      "type": "array"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/RequirementSelfContradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "formal_backend_response": {
      "anyOf": [
        {
          "$ref": "#/$defs/FormalBackendResponse"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "result": {
      "$ref": "#/$defs/BackendResult"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "valid",
        "contradiction",
        "unsupported",
        "timeout",
        "tool_error"
      ],
      "title": "Status",
      "type": "string"
    },
    "taxonomy_version": {
      "const": "alice-style-0.1",
      "default": "alice-style-0.1",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "unsupported_constructs": {
      "items": {
        "$ref": "#/$defs/UnsupportedConstruct"
      },
      "title": "Unsupported Constructs",
      "type": "array"
    },
    "untrusted_suggestions": {
      "items": {
        "$ref": "#/$defs/UntrustedContradictionSuggestion"
      },
      "title": "Untrusted Suggestions",
      "type": "array"
    }
  },
  "required": [
    "requirement_id",
    "status",
    "result"
  ],
  "title": "RequirementSelfConsistencyResult",
  "type": "object"
}
