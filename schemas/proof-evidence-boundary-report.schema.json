{
  "$defs": {
    "EvidenceBoundaryFinding": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "evidence_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "blocking"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "severity",
        "message"
      ],
      "title": "EvidenceBoundaryFinding",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "TYPE_CHECKED",
        "CONSISTENCY_CHECKED",
        "STATICALLY_RESOLVED",
        "SMT_CHECKED",
        "TEST_VALIDATED",
        "TRACE_VALIDATED",
        "BOUNDED_CHECKED",
        "PROVEN_INDUCTIVE",
        "REVIEWED"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/EvidenceBoundaryFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "highest_claim": {
      "enum": [
        "none",
        "reviewed",
        "bounded",
        "inductive"
      ],
      "title": "Highest Claim",
      "type": "string"
    },
    "proof_id": {
      "title": "Proof Id",
      "type": "string"
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "result": {
      "enum": [
        "passed",
        "blocked"
      ],
      "title": "Result",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool": {
      "default": "nlreq.evidence_boundary",
      "title": "Tool",
      "type": "string"
    },
    "tool_version": {
      "default": "0.1",
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "proof_id",
    "requirement_id",
    "result",
    "highest_claim"
  ],
  "title": "ProofEvidenceBoundaryReport",
  "type": "object"
}
