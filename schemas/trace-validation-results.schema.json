{
  "$defs": {
    "BackendResult": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "evidence_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "valid",
            "invalid",
            "counterexample",
            "timeout",
            "unsupported",
            "needs_review"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "status"
      ],
      "title": "BackendResult",
      "type": "object"
    },
    "Counterexample": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "counterexample_id": {
          "title": "Counterexample Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "counterexample_id",
        "backend",
        "description"
      ],
      "title": "Counterexample",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "TYPE_CHECKED",
        "CONSISTENCY_CHECKED",
        "STATICALLY_RESOLVED",
        "SMT_CHECKED",
        "TEST_VALIDATED",
        "TRACE_VALIDATED",
        "BOUNDED_CHECKED",
        "PROVEN_INDUCTIVE",
        "REVIEWED"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "const": "trace",
      "default": "trace",
      "title": "Adapter",
      "type": "string"
    },
    "counterexamples": {
      "items": {
        "$ref": "#/$defs/Counterexample"
      },
      "title": "Counterexamples",
      "type": "array"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/BackendResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "TraceValidationResultsArtifact",
  "type": "object"
}
