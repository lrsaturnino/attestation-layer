          "title": "Current Hash"
        },
        "formalism": {
          "title": "Formalism",
          "type": "string"
        },
        "freshness": {
          "title": "Freshness",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
