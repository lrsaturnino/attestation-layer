      "title": "Composition Id",
      "type": "string"
    },
    "impact_hash": {
      "title": "Impact Hash",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "lowered_hash": {
      "title": "Lowered Hash",
      "type": "string"
    },
    "namespace_policy": {
      "items": {
        "type": "string"
      },
      "title": "Namespace Policy",
      "type": "array"
    },
    "preserved_invariants": {
      "items": {
        "type": "string"
      },
      "title": "Preserved Invariants",
      "type": "array"
    },
    "requirement_hash": {
      "title": "Requirement Hash",
      "type": "string"
