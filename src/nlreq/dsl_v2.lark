start: requirement

requirement: scope premise_block obligation_block "."?
scope: "For" "every" NAME ":"
premise_block: "when" premise ("and" premise)*
obligation_block: "then" NAME "must" obligation ("and" obligation)*

premise: NAME "is" "authorized"      -> authorized
       | NAME "is" "confirmed"       -> confirmed
       | NAME "<=" NAME              -> lte
       | NAME ">=" NAME              -> gte

obligation: "emit" NAME "within" NUMBER TIME_UNIT -> emit_within
          | "keep" NAME ">=" NAME                 -> keep_gte
          | "keep" NAME "<=" NAME                 -> keep_lte

TIME_UNIT: "second" | "seconds" | "minute" | "minutes" | "hour" | "hours" | "day" | "days" | "block" | "blocks"
NAME: /[A-Za-z_][A-Za-z0-9_]*/
NUMBER: /[0-9]+(\.[0-9]+)?/

%import common.WS
%ignore WS
