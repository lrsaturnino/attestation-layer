{
  "openapi": "3.1.0",
  "info": {
    "title": "Sample Operation API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/duplicates/a": {
      "post": {
        "operationId": "duplicate_operation",
        "responses": {
          "200": {
            "description": "Accepted"
          }
        }
      }
    },
    "/duplicates/b": {
      "post": {
        "operationId": "duplicate_operation",
        "responses": {
          "200": {
            "description": "Accepted"
          }
        }
      }
    },
    "/operation": {
      "post": {
        "operationId": "operation",
        "x-nlreq-state-transition": "state_change",
        "parameters": [
          {
            "name": "request_id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "OperationRequest": {
        "type": "object"
      },
      "OperationResponse": {
        "type": "object"
      }
    }
  }
}
